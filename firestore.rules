rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsBackup(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validBackup() {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion', 'backupId', 'revision', 'savedAt', 'payloadJson'])
        && d.keys().hasOnly(['schemaVersion', 'backupId', 'revision', 'savedAt', 'payloadJson'])
        && d.schemaVersion == 1
        && d.backupId is string && d.backupId.matches('^[a-f0-9-]{36}$')
        && d.revision is int && d.revision > 0 && d.revision <= 9007199254740991
        && d.savedAt is timestamp && d.savedAt == request.time
        && d.payloadJson is string && d.payloadJson.size() > 0
        && d.payloadJson.size() <= 768000;
    }

    match /users/{uid}/backups/manual {
      allow get, delete: if ownsBackup(uid);
      allow create: if ownsBackup(uid) && validBackup() && request.resource.data.revision == 1;
      allow update: if ownsBackup(uid) && validBackup()
        && request.resource.data.backupId == resource.data.backupId
        && request.resource.data.revision == resource.data.revision + 1;
      allow list: if false;
    }

    function ownsChecklist(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function verifiedChecklistOwner(uid) {
      return ownsChecklist(uid) && request.auth.token.email_verified == true;
    }

    function validTaskKey(taskKey) {
      return taskKey.matches('^(kitchen|bedroom|living|wardrobe|garden|shed|garage|workspace|office-storage|shared-spaces)-[0-4]$');
    }

    function validChecklistDocument(uid, taskKey, d) {
      return d.keys().hasAll(['protocol', 'uid', 'taskKey', 'completed', 'revision', 'updatedAt'])
        && d.keys().hasOnly(['protocol', 'uid', 'taskKey', 'completed', 'revision', 'updatedAt'])
        && d.protocol == 'resettable-checklist-ticks-v1'
        && d.uid == uid
        && d.taskKey == taskKey
        && d.completed is bool
        && d.revision is int && d.revision > 0 && d.revision <= 9007199254740991
        && d.updatedAt is timestamp;
    }

    match /users/{uid}/checklistSyncV1/{taskKey} {
      allow get: if verifiedChecklistOwner(uid) && validTaskKey(taskKey);
      allow list: if verifiedChecklistOwner(uid);
      allow create: if verifiedChecklistOwner(uid) && validTaskKey(taskKey)
        && validChecklistDocument(uid, taskKey, request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if verifiedChecklistOwner(uid) && validTaskKey(taskKey)
        && validChecklistDocument(uid, taskKey, resource.data)
        && validChecklistDocument(uid, taskKey, request.resource.data)
        && request.resource.data.protocol == resource.data.protocol
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.taskKey == resource.data.taskKey
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
